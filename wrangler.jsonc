{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "room-planner",
  "compatibility_date": "2026-11-13",
  // No account_id here on purpose: it comes from CLOUDFLARE_ACCOUNT_ID (CI secret / local env).
  // Assets-only Worker: no `main`, so no Worker code ever runs; the assets layer serves everything.
  "assets": {
    "directory": "./dist",
    // Astro emits dist/404.html; serve it (with a 404 status) for unknown paths.
    "not_found_handling": "404-page",
  },
  // Custom domain. Cloudflare creates the DNS record itself. The old hostname
  // (roomplanner.andrechek.com) is served by the separate legacy/ Worker (see docs/DEPLOY.md).
  "routes": [{ "pattern": "room-planner.andrechek.com", "custom_domain": true }],
  // Branch Previews: Workers Builds runs `npx wrangler preview` for non-main branches,
  // served on workers.dev (noindex). The block can stay empty; top-level settings apply.
  "previews": {},
  "preview_urls": true,
  "workers_dev": true,
  "observability": { "enabled": true },
}
