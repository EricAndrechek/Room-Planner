{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "room-planner",
  "compatibility_date": "2026-11-13",
  // No account_id here on purpose: it comes from CLOUDFLARE_ACCOUNT_ID (CI secret / local env).
  // The Worker (worker/index.ts) serves only the MCP server. Everything else is static assets,
  // served by the assets layer without invoking the Worker (Workers Free counts invocations).
  "main": "worker/index.ts",
  // Bundles the MCP plan viewer (worker/viewer/) before every dev, deploy and preview build.
  "build": { "command": "node scripts/build-viewer.mjs" },
  // Smaller bundle, faster isolate start-up; source maps keep stack traces readable.
  "minify": true,
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only these paths run the Worker first; every other request is an asset or the 404 page.
    // Only the pages (for the Markdown router), the MCP server and the API run the Worker; every
    // asset is served without it (docs/DEPLOY.md, "Discovery for agents").
    "run_worker_first": [
      "/",
      "/help/",
      "/faq/",
      "/agents/",
      "/privacy/",
      "/support/",
      "/terms/",
      "/guides/*",
      "!/guides/*.md",
      "/mcp",
      "/mcp/*",
      "/api/*",
    ],
    // Astro emits dist/404.html; serve it (with a 404 status) for unknown paths.
    "not_found_handling": "404-page",
  },
  // Per client IP, for /mcp and /mcp/* (docs/design/plan-format.md, section 7). Counters are per
  // Cloudflare location and approximate. namespace_id is unique within the account.
  "ratelimits": [
    { "name": "MCP_LIMIT", "namespace_id": "4704", "simple": { "limit": 120, "period": 60 } },
  ],
  // Custom domain. Cloudflare creates the DNS record itself. The old hostname
  // (roomplanner.andrechek.com) is a Cloudflare redirect rule, not part of this repo (see docs/DEPLOY.md).
  "routes": [{ "pattern": "room-planner.andrechek.com", "custom_domain": true }],
  // Branch Previews: Workers Builds runs `npx wrangler preview` for non-main branches, served on
  // workers.dev (noindex). Previews do not inherit bindings, so the rate limit is repeated here,
  // on its own namespace so previews never share production's counters.
  "previews": {
    "ratelimits": [
      { "name": "MCP_LIMIT", "namespace_id": "4705", "simple": { "limit": 120, "period": 60 } },
    ],
  },
  "preview_urls": true,
  "workers_dev": true,
  "observability": { "enabled": true },
}
