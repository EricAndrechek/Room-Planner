{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "room-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-13",
  // No account_id here on purpose: it comes from CLOUDFLARE_ACCOUNT_ID (CI secret / local env).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Astro emits dist/404.html; serve it (with a 404 status) for unknown paths.
    "not_found_handling": "404-page",
    // Static requests are served by the assets layer without invoking the Worker (free, no CPU).
    // Only the PostHog reverse proxy runs Worker code.
    "run_worker_first": ["/rpq/*"],
  },
  // Custom domain. Cloudflare creates the DNS record itself, so any existing
  // `roomplanner` CNAME must be deleted first (see docs/DEPLOY.md).
  "routes": [{ "pattern": "roomplanner.andrechek.com", "custom_domain": true }],
  // Branch Previews: Workers Builds runs `npx wrangler preview` for non-main branches,
  // served on workers.dev (noindex). The block can stay empty; top-level settings apply.
  "previews": {},
  "preview_urls": true,
  "workers_dev": true,
  "observability": { "enabled": true },
}
