---
// PostHog web snippet (https://posthog.com/docs/libraries/astro). The snippet stubs `window.posthog`
// and queues calls until the SDK finishes loading, so `src/lib/analytics.ts` can call it any time.
import { execSync } from 'node:child_process';
import pkg from '../../package.json';

// Build-time release label: Workers Builds exposes the commit sha; fall back to git, then the version.
let sha = process.env.WORKERS_CI_COMMIT_SHA ?? '';
try {
  sha ||= execSync('git rev-parse HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString();
} catch {
  /* not a git checkout */
}
const appVersion = sha ? `${pkg.version}+${sha.trim().slice(0, 7)}` : pkg.version;
---

<script is:inline define:vars={{ appVersion }}>
