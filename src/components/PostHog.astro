  const ls = (key) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };
  const host = location.hostname;
  const debug = ls('rp:analytics-debug') === '1';
  const local = host === 'localhost' || host === '127.0.0.1';

  // Off under automation (tests) and on localhost, unless opted in for manual debugging.
  if (debug || (!navigator.webdriver && !local)) {
    posthog.init('phc_ykKVRqy82jxfkj4MNtEUhTRZKSLUQ2sDtUXizUoWQ77r', {
      api_host: '/rpq', // same-origin reverse proxy (worker/proxy.ts); the path is deliberately not obvious
      ui_host: 'https://us.posthog.com',
      defaults: '2026-08-30',
      person_profiles: 'identified_only',
      capture_exceptions: true,
      respect_dnt: true,
      opt_out_capturing_by_default: ls('rp:analytics-optout') === '1',
      session_recording: { maskAllInputs: true },
      debug,
      loaded: (ph) =>
        ph.register({
          app_version: appVersion,
          environment:
            host === 'roomplanner.andrechek.com'
              ? 'production'
              : host.endsWith('.workers.dev')
                ? 'preview'
                : 'development',
        }),
    });
  }
</script>
