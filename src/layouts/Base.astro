---
import '../styles/global.css';
import PostHog from '../components/PostHog.astro';
import { API_POINTER_PAGES, PATHS, markdownPath } from '../../scripts/discovery.mjs';
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_TITLE,
  FEATURES,
  OG_IMAGE,
  SITE_ALT_NAME,
  SITE_NAME,
  THEME_COLOR,
} from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Full-screen app shell (fixed, non-scrolling body). */
  app?: boolean;
  /** Emit the WebApplication JSON-LD (home page). Every indexable page gets the WebSite node. */
  structuredData?: boolean;
  /** Extra JSON-LD nodes for this page's `@graph` (WebPage, BreadcrumbList, FAQPage...). */
  jsonLd?: Record<string, unknown>[];
  /** Social card for this page (site-relative path); defaults to the site-wide one. */
  ogImage?: { path: string; width: number; height: number; alt: string };
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  app = false,
  structuredData = false,
  jsonLd: pageJsonLd = [],
  ogImage: og = OG_IMAGE,
  ogType = 'website',
  noindex = false,
} = Astro.props;

// All absolute URLs derive from `site` (astro.config: SITE_URL) + base.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const site = Astro.site ?? new URL(Astro.url.origin);
const abs = (path: string) => new URL(`${base}/${path.replace(/^\/+/, '')}`, site).toString();
const asset = (path: string) => `${base}/${path.replace(/^\/+/, '')}`;
const canonical = new URL(Astro.url.pathname, site).toString();
const homeUrl = abs('');
// Discovery (scripts/discovery.mjs): the page's Markdown twin, and on / and /agents/ the API.
const pagePath = Astro.url.pathname.slice(base.length).replace(/^\/+/, '');
const markdown = noindex ? null : markdownPath(pagePath);
const apiPointers = !noindex && API_POINTER_PAGES.includes(pagePath);
const ogImage = abs(og.path);

const website = {
  '@type': 'WebSite',
  '@id': `${homeUrl}#website`,
  name: SITE_NAME,
  alternateName: SITE_ALT_NAME,
  url: homeUrl,
  inLanguage: 'en',
};
const webApplication = {
  '@type': 'WebApplication',
  '@id': `${homeUrl}#app`,
  name: SITE_NAME,
  url: homeUrl,
  description: DEFAULT_DESCRIPTION,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Any (runs in a web browser)',
  browserRequirements: 'Requires JavaScript. Works in any modern browser.',
  isAccessibleForFree: true,
  inLanguage: 'en',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [...FEATURES],
  image: ogImage,
  screenshot: [
    {
      '@type': 'ImageObject',
      url: abs('screenshots/wide.webp'),
      width: 1280,
      height: 800,
      caption: 'Arranging furniture to scale on a floor plan (desktop)',
    },
    {
      '@type': 'ImageObject',
      url: abs('screenshots/narrow.webp'),
      width: 780,
      height: 1688,
      caption: 'The planner on a phone',
    },
  ],
  softwareHelp: { '@type': 'CreativeWork', url: abs('help/') },
  isPartOf: { '@id': `${homeUrl}#website` },
};
const graph = noindex ? [] : [website, ...(structuredData ? [webApplication] : []), ...pageJsonLd];
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en" class={app ? 'app' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href={asset('manifest.webmanifest')} />

    <link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <!-- Google's favicon service wants a square icon whose size is a multiple of 48 px; it feeds
         the icon other apps show for this site (e.g. MCP connector lists). -->
    <link rel="icon" href={asset('pwa-192x192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={og.alt} />

    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    {markdown && <link rel="alternate" type="text/markdown" href={asset(markdown)} />}
    {apiPointers && (
      <>
        <link rel="service-desc" type="application/openapi+json" href={asset(PATHS.openapi)} />
        <link rel="api-catalog" href={asset(PATHS.apiCatalog)} />
        <link rel="service-doc" href={asset(PATHS.agents)} />
        <link rel="describedby" type="text/plain" href={asset(PATHS.llms)} />
      </>
    )}
    {graph.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )}
    <PostHog />
    <slot name="head" />
  </head>
  <body class={app ? 'bg-slate-50 text-slate-800' : 'bg-slate-50 text-slate-800 min-h-screen'}>
    {!app && (
      <a
        href="#main"
        class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:bg-white focus:text-indigo-700 focus:rounded-lg focus:shadow-lg focus:font-medium"
      >
        Skip to main content
      </a>
    )}
    <slot />
  </body>
</html>
