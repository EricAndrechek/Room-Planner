---
import '../styles/global.css';
import PostHog from '../components/PostHog.astro';
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_TITLE,
  OG_IMAGE,
  SITE_ALT_NAME,
  SITE_NAME,
  THEME_COLOR,
} from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Full-screen app shell (fixed, non-scrolling body). */
  app?: boolean;
  /** Emit WebSite + WebApplication JSON-LD (home page). */
  structuredData?: boolean;
  noindex?: boolean;
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  app = false,
  structuredData = false,
  noindex = false,
} = Astro.props;

// All absolute URLs derive from `site` (astro.config: SITE_URL) + base.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const site = Astro.site ?? new URL(Astro.url.origin);
const abs = (path: string) => new URL(`${base}/${path.replace(/^\/+/, '')}`, site).toString();
const asset = (path: string) => `${base}/${path.replace(/^\/+/, '')}`;
const canonical = new URL(Astro.url.pathname, site).toString();
const homeUrl = abs('');
const ogImage = abs(OG_IMAGE.path);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${homeUrl}#website`,
      name: SITE_NAME,
      alternateName: SITE_ALT_NAME,
      url: homeUrl,
    },
    {
      '@type': 'WebApplication',
      '@id': `${homeUrl}#app`,
      name: SITE_NAME,
      url: homeUrl,
      description: DEFAULT_DESCRIPTION,
      applicationCategory: 'DesignApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript. Works in any modern browser.',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      image: ogImage,
    },
  ],
};
---

<!doctype html>
<html lang="en" class={app ? 'app' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href={asset('manifest.webmanifest')} />

    <link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />

    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <PostHog />
    <slot name="head" />
  </head>
  <body class={app ? 'bg-slate-50 text-slate-800' : 'bg-slate-50 text-slate-800 min-h-screen'}>
    <slot />
    <script>
      // Visitors bridged from the old domain can land on any page (e.g. /help/). The planner
      // (html.app) imports the carried data itself before it reads storage; every other page
      // imports it here so the data is already in place when they open the planner.
      import { hasMigrationHash, importMigration } from '../lib/migrate';
      if (!document.documentElement.classList.contains('app') && hasMigrationHash(location.hash)) {
        void importMigration(window.location, window.localStorage, (url) =>
          window.history.replaceState(window.history.state, '', url),
        );
      }
    </script>
  </body>
</html>
