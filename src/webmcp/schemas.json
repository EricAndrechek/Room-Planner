{
  "get_plan": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "check_layout": {
    "type": "object",
    "properties": {
      "minClearance": {
        "type": "number",
        "minimum": 0,
        "maximum": 10000,
        "description": "Gaps from 6 in (15 cm) up to this are reported as tight_clearance. Default 24 in (61 cm)."
      }
    },
    "additionalProperties": false
  },
  "add_item": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "maxLength": 80,
        "description": "E.g. \"Queen bed\"."
      },
      "width": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10000,
        "description": "Along x, before rotation."
      },
      "depth": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10000,
        "description": "Along y, before rotation."
      },
      "color": {
        "description": "Fill, \"#rrggbb\".",
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "shape": {
        "description": "\"ellipse\": round or oval; \"l\" needs cut.",
        "type": "string",
        "enum": ["rect", "l", "ellipse"]
      },
      "cut": {
        "description": "Shape \"l\" only: the rectangle removed from one corner.",
        "type": "object",
        "properties": {
          "corner": {
            "type": "string",
            "enum": ["tl", "tr", "br", "bl"],
            "description": "Corner removed."
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000,
            "description": "Removed part, along x."
          },
          "depth": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000,
            "description": "Removed part, along y."
          }
        },
        "required": ["corner", "width", "depth"]
      },
      "locked": {
        "description": "Not movable in the planner.",
        "type": "boolean"
      },
      "hidden": {
        "description": "Not drawn or checked.",
        "type": "boolean"
      },
      "notes": {
        "description": "The user's notes.",
        "type": "string",
        "maxLength": 500
      },
      "placement": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          },
          "y": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          },
          "rotation": {
            "type": "number",
            "minimum": -3600,
            "maximum": 3600,
            "description": "Clockwise degrees (kept between 0 and 360)."
          }
        },
        "required": ["x", "y"],
        "additionalProperties": false,
        "description": "Centre of the piece in floor coordinates (x right, y down) and its clockwise rotation."
      },
      "place": {
        "type": "boolean",
        "description": "Without a placement: true puts the piece in a free spot of the room (roomId); false or left out sets it aside."
      },
      "roomId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "A room id from get_plan. Default: the first room."
      }
    },
    "required": ["label", "width", "depth"],
    "additionalProperties": false
  },
  "update_item": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "An id from get_plan."
      },
      "label": {
        "description": "E.g. \"Queen bed\".",
        "type": "string",
        "maxLength": 80
      },
      "width": {
        "description": "Along x, before rotation.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10000
      },
      "depth": {
        "description": "Along y, before rotation.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10000
      },
      "color": {
        "description": "Fill, \"#rrggbb\".",
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "shape": {
        "description": "\"ellipse\": round or oval; \"l\" needs cut.",
        "type": "string",
        "enum": ["rect", "l", "ellipse"]
      },
      "cut": {
        "description": "Shape \"l\" only: the rectangle removed from one corner.",
        "type": "object",
        "properties": {
          "corner": {
            "type": "string",
            "enum": ["tl", "tr", "br", "bl"],
            "description": "Corner removed."
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000,
            "description": "Removed part, along x."
          },
          "depth": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000,
            "description": "Removed part, along y."
          }
        },
        "required": ["corner", "width", "depth"]
      },
      "locked": {
        "description": "Not movable in the planner.",
        "type": "boolean"
      },
      "hidden": {
        "description": "Not drawn or checked.",
        "type": "boolean"
      },
      "notes": {
        "description": "The user's notes.",
        "type": "string",
        "maxLength": 500
      },
      "placement": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          },
          "y": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          },
          "rotation": {
            "type": "number",
            "minimum": -3600,
            "maximum": 3600,
            "description": "Clockwise degrees (kept between 0 and 360)."
          }
        },
        "additionalProperties": false,
        "description": "Move or turn the piece: its centre (x right, y down) and clockwise rotation. Each part optional."
      }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "set_aside_item": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "An id from get_plan."
      }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "place_item": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "An id from get_plan."
      },
      "at": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          },
          "y": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          }
        },
        "required": ["x", "y"],
        "additionalProperties": false,
        "description": "Where its centre goes (floor coordinates); it is moved the least amount that keeps it inside the room there. Left out: a free spot in roomId."
      },
      "roomId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "A room id from get_plan. Default: the first room."
      }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "remove_item": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "An id from get_plan."
      }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "add_opening": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": ["door", "window"],
        "description": "Door or window."
      },
      "roomId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "A room id from get_plan. Default: the first room."
      },
      "wall": {
        "description": "Wall i runs from outline[i] to outline[i+1].",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "offset": {
        "description": "From the wall's start corner to the opening's near edge.",
        "type": "number",
        "minimum": 0
      },
      "width": {
        "description": "Width along the wall.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10000
      },
      "type": {
        "description": "Doors only. \"swing-in\": into the room that lists it.",
        "type": "string",
        "enum": [
          "swing-in",
          "swing-out",
          "double-in",
          "double-out",
          "sliding",
          "pocket",
          "bifold",
          "opening"
        ]
      },
      "hinge": {
        "description": "Doors only. \"start\": on the left, from inside facing the wall.",
        "type": "string",
        "enum": ["start", "end"]
      },
      "swingAngle": {
        "anyOf": [
          {
            "type": "number",
            "const": 90
          },
          {
            "type": "number",
            "const": 180
          }
        ],
        "description": "Doors only: how far it opens. Default 90."
      }
    },
    "required": ["kind"],
    "additionalProperties": false
  },
  "update_opening": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "An id from get_plan."
      },
      "wall": {
        "description": "Wall i runs from outline[i] to outline[i+1].",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "offset": {
        "description": "From the wall's start corner to the opening's near edge.",
        "type": "number",
        "minimum": 0
      },
      "width": {
        "description": "Width along the wall.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10000
      },
      "type": {
        "description": "Doors only. \"swing-in\": into the room that lists it.",
        "type": "string",
        "enum": [
          "swing-in",
          "swing-out",
          "double-in",
          "double-out",
          "sliding",
          "pocket",
          "bifold",
          "opening"
        ]
      },
      "hinge": {
        "description": "Doors only. \"start\": on the left, from inside facing the wall.",
        "type": "string",
        "enum": ["start", "end"]
      },
      "swingAngle": {
        "anyOf": [
          {
            "type": "number",
            "const": 90
          },
          {
            "type": "number",
            "const": 180
          }
        ],
        "description": "Doors only: how far it opens. Default 90."
      }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "remove_opening": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "An id from get_plan."
      }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "add_room": {
    "type": "object",
    "properties": {
      "besideRoomId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "The new room goes against a free side of this room, sharing a wall. Default: the first room."
      },
      "name": {
        "type": "string",
        "maxLength": 80
      },
      "width": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10000,
        "description": "Along x. Default 10 ft (3.05 m)."
      },
      "depth": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10000,
        "description": "Along y. Default 10 ft (3.05 m)."
      }
    },
    "additionalProperties": false
  },
  "update_room": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "An id from get_plan."
      },
      "name": {
        "type": "string",
        "maxLength": 80,
        "description": "Empty: the room is called \"Room N\" again."
      },
      "x": {
        "type": "number",
        "minimum": -100000,
        "maximum": 100000,
        "description": "Moves the room (with its furniture): its bounding box's left edge, floor x."
      },
      "y": {
        "type": "number",
        "minimum": -100000,
        "maximum": 100000,
        "description": "Moves the room (with its furniture): its bounding box's top edge, floor y."
      }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "remove_room": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "An id from get_plan."
      }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "replace_plan": {
    "type": "object",
    "properties": {
      "plan": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 4,
            "description": "Always 4."
          },
          "name": {
            "default": "Untitled",
            "description": "Plan name.",
            "type": "string",
            "maxLength": 100
          },
          "unit": {
            "type": "string",
            "enum": ["ft", "in", "m", "cm"],
            "description": "Unit of every length."
          },
          "rooms": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,40}$",
                  "description": "Unique in the plan."
                },
                "name": {
                  "description": "E.g. \"Bedroom\".",
                  "type": "string",
                  "maxLength": 80
                },
                "outline": {
                  "minItems": 3,
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000,
                        "description": "Floor x (grows right)."
                      },
                      "y": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000,
                        "description": "Floor y (grows DOWN)."
                      }
                    },
                    "required": ["x", "y"]
                  },
                  "description": "Interior corners, clockwise. Rectangle from top-left: walls 0 top, 1 right, 2 bottom, 3 left."
                },
                "openings": {
                  "default": [],
                  "description": "Doors and windows.",
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,40}$",
                        "description": "Unique in the plan."
                      },
                      "kind": {
                        "type": "string",
                        "enum": ["door", "window"],
                        "description": "Door or window."
                      },
                      "wall": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "description": "Wall i runs from outline[i] to outline[i+1]."
                      },
                      "offset": {
                        "type": "number",
                        "minimum": 0,
                        "description": "From the wall's start corner to the opening's near edge."
                      },
                      "width": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 10000,
                        "description": "Width along the wall."
                      },
                      "from": {
                        "description": "Input only: the end offset is measured from. Default \"start\".",
                        "type": "string",
                        "enum": ["start", "end", "left", "right", "top", "bottom"]
                      },
                      "type": {
                        "default": "swing-in",
                        "description": "Doors only. \"swing-in\": into the room that lists it.",
                        "type": "string",
                        "enum": [
                          "swing-in",
                          "swing-out",
                          "double-in",
                          "double-out",
                          "sliding",
                          "pocket",
                          "bifold",
                          "opening"
                        ]
                      },
                      "hinge": {
                        "default": "start",
                        "description": "Doors only. \"start\": on the left, from inside facing the wall.",
                        "type": "string",
                        "enum": ["start", "end"]
                      },
                      "swingAngle": {
                        "description": "Doors only: how far it opens, degrees.",
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 90
                          },
                          {
                            "type": "number",
                            "const": 180
                          }
                        ]
                      }
                    },
                    "required": ["id", "kind", "wall", "offset", "width"],
                    "additionalProperties": {}
                  }
                }
              },
              "required": ["id", "outline"],
              "additionalProperties": {}
            },
            "description": "One floor: rooms touch to share a wall, never overlap."
          },
          "items": {
            "default": [],
            "description": "Furniture.",
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,40}$",
                  "description": "Unique in the plan."
                },
                "label": {
                  "type": "string",
                  "maxLength": 80,
                  "description": "E.g. \"Queen bed\"."
                },
                "color": {
                  "default": "#93c5fd",
                  "description": "Fill, \"#rrggbb\".",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "shape": {
                  "default": "rect",
                  "description": "\"ellipse\": round or oval; \"l\" needs cut.",
                  "type": "string",
                  "enum": ["rect", "l", "ellipse"]
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000,
                  "description": "Along x, before rotation."
                },
                "depth": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000,
                  "description": "Along y, before rotation."
                },
                "cut": {
                  "description": "Shape \"l\" only: the rectangle removed from one corner.",
                  "type": "object",
                  "properties": {
                    "corner": {
                      "type": "string",
                      "enum": ["tl", "tr", "br", "bl"],
                      "description": "Corner removed."
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 10000,
                      "description": "Removed part, along x."
                    },
                    "depth": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 10000,
                      "description": "Removed part, along y."
                    }
                  },
                  "required": ["corner", "width", "depth"]
                },
                "placement": {
                  "description": "Omit to set the piece aside: off the floor, not checked.",
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": -100000,
                      "maximum": 100000,
                      "description": "Floor x of the CENTRE."
                    },
                    "y": {
                      "type": "number",
                      "minimum": -100000,
                      "maximum": 100000,
                      "description": "Floor y of the CENTRE."
                    },
                    "rotation": {
                      "default": 0,
                      "description": "Clockwise degrees.",
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 360
                    }
                  },
                  "required": ["x", "y"]
                },
                "locked": {
                  "description": "Not movable in the planner.",
                  "type": "boolean"
                },
                "hidden": {
                  "description": "Not drawn or checked.",
                  "type": "boolean"
                },
                "notes": {
                  "description": "The user's notes.",
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": ["id", "label", "width", "depth"],
              "additionalProperties": {}
            }
          },
          "settings": {
            "description": "Display preferences.",
            "type": "object",
            "properties": {
              "unitSystem": {
                "description": "Display unit. Default: unit (\"ft\" as \"ft-in\").",
                "type": "string",
                "enum": ["ft-in", "ft", "in", "m", "cm"]
              }
            },
            "additionalProperties": {}
          }
        },
        "required": ["version", "unit", "rooms"],
        "additionalProperties": {}
      }
    },
    "required": ["plan"],
    "additionalProperties": false
  }
}
