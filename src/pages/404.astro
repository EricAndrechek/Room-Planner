---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/paths';
---

<Base title="Page not found — Room Planner" description="This page doesn't exist." noindex>
  <main
    id="main"
    tabindex="-1"
    class="outline-hidden min-h-screen flex items-center justify-center p-6"
  >
    <div class="max-w-md text-center space-y-4">
      <img src={withBase('favicon.svg')} width="64" height="64" alt="" class="mx-auto" />
      <h1 class="text-2xl font-bold text-slate-800">Page not found</h1>
      <p class="text-slate-600">The page you were looking for doesn't exist or has moved.</p>
      <div class="flex gap-3 justify-center">
        <a
          href={withBase('')}
          class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-medium"
        >
          Open Room Planner
        </a>
        <a
          href={withBase('help/')}
          class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-sm font-medium"
        >
          Help &amp; FAQ
        </a>
      </div>
    </div>
  </main>
</Base>
