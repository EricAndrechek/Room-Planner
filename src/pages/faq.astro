---
import Content from '../layouts/Content.astro';
import { DOOR_TYPES } from '../lib/constants';
import { withBase } from '../lib/paths';

const title = 'Room Planner FAQ: Free, No Sign-Up, Private, Works on Phones';
const description =
  'Short answers about Room Planner: is it free, do you need an account, where your floor plans are stored, phones and tablets, sharing, exporting, metric units, offline use and door types.';

const link = (path: string, text: string) => `<a href="${withBase(path)}">${text}</a>`;
// "swing in, swing out, double (French), in, ..., opening (no door)" from the door card's labels.
const doorTypes = DOOR_TYPES.map((d) =>
  d.label.replace(/^[A-Z](?=[a-z ])/, (c) => c.toLowerCase()),
).join('; ');

// Answers are HTML; the same strings fill the page and the FAQPage JSON-LD, so they always match.
const faqs: { q: string; a: string }[] = [
  {
    q: 'Is Room Planner free?',
    a: 'Yes. Every feature is free to use. There is no trial, no paid version and no sign-up.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. Open the planner and start drawing. There are no accounts, so there is nothing to log in to.',
  },
  {
    q: 'Where are my floor plans stored?',
    a: `In your browser, on your device (local storage). The planner never uploads your layouts to a server. Clearing your browser's site data deletes them, so export a backup now and then. Anonymous usage analytics, which never include your layouts or plan names, can be turned off on the ${link('help/#privacy', 'help page')}.`,
  },
  {
    q: 'Can an AI assistant plan my room?',
    a: `Yes. ${link('agents/', 'Room Planner’s MCP server')} works with Claude, ChatGPT, VS Code, Cursor and other MCP apps: the assistant lays out the room, checks it for clashes and blocked doors, and gives you a link that opens the plan in the planner. It is free and needs no account. The server only sees the plans an assistant sends it, processes them in memory and stores nothing.`,
  },
  {
    q: 'Can I use it on a phone or tablet?',
    a: 'Yes. On a phone the editor opens as a panel over the plan; pinch to zoom, drag the background to pan and drag furniture with your finger. It works in any modern mobile browser.',
  },
  {
    q: 'How do I share a floor plan?',
    a: 'Click Share / Save to copy a link. Whoever opens it gets a copy of your layout as a new plan in their own browser. The layout is stored inside the link itself (after the #), so it is never sent to a server. A link is a snapshot: share a new one after you make changes.',
  },
  {
    q: 'Can I export or print my floor plan?',
    a: 'Yes. Click Export to download the plan as a PNG image or a PDF (A4 or Letter), or to print it. The drawing is to scale, with dimensions and a scale bar. You can also export plans as a JSON backup from My Floor Plans and import them again later.',
  },
  {
    q: 'Does it support metric units?',
    a: `Yes. Show measurements in feet and inches, decimal feet, inches, meters or centimeters, and switch at any time. You can type a value in any unit, such as 12'6", 3.5m or 350cm, and it is converted for you.`,
  },
  {
    q: 'Does it work offline?',
    a: 'Yes. After your first visit the planner, the help page and your floor plans work without an internet connection. You can also install it as an app from your browser (on iPhone and iPad: Share, then Add to Home Screen).',
  },
  {
    q: 'What kinds of doors and windows can I add?',
    a: `Any number of doors and windows on any wall. Door types: ${doorTypes}. Swing doors can open to 90° or 180° and show their swing arc, and the planner warns you when furniture is in a door's way.`,
  },
  {
    q: 'Can I save more than one floor plan?',
    a: 'Yes. My Floor Plans (the folder icon) lets you create, open, rename, duplicate and delete plans. Every change is saved automatically.',
  },
  {
    q: 'Can I move my plans to another device?',
    a: 'Plans do not sync between devices. To move one, open a share link on the other device, or export your plans as JSON and import them there.',
  },
  {
    q: 'Can it draw a whole house, odd-shaped rooms or 3D?',
    a: 'No. Room Planner draws one rectangular room at a time, in 2D, seen from above, and furniture pieces are rectangles you size yourself. For a home with several rooms, make one plan per room.',
  },
  {
    q: 'What size should my furniture be, and how much space should I leave around it?',
    a: `The ${link('guides/', 'room layout guides')} list standard sizes and clearances for bedrooms, living rooms, studios, dorms and home offices, with example plans you can open in the planner.`,
  },
];

const jsonLd = [
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Content
  title={title}
  description={description}
  breadcrumbs={[{ name: 'FAQ', path: 'faq/' }]}
  jsonLd={jsonLd}
>
  <h1 class="text-3xl font-bold text-slate-900 mb-3">Frequently asked questions</h1>
  <p class="text-lg text-slate-600 mb-8">
    Short answers about Room Planner. For step-by-step instructions, see the{' '}
    <a href={withBase('help/')} class="text-indigo-700 underline hover:text-indigo-900">
      help page
    </a>
    .
  </p>
  <div class="space-y-6">
    {faqs.map((f) => (
      <section class="bg-white border border-slate-200 rounded-xl p-5" data-faq>
        <h2 class="text-lg font-bold text-slate-900 mb-2">{f.q}</h2>
        <p
          class="text-slate-700 leading-relaxed [&_a]:text-indigo-700 [&_a]:underline"
          set:html={f.a}
        />
      </section>
    ))}
  </div>
  <p class="mt-10 text-center">
    <a
      href={withBase('')}
      class="inline-block px-5 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-medium transition-colors"
    >
      Start planning your room
    </a>
  </p>
</Content>
