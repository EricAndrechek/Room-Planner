---
import Content from '../layouts/Content.astro';
import { withBase } from '../lib/paths';
import { SHORTCUT_GROUPS, shortcutKeys } from '../lib/shortcuts';
import { SITE_NAME } from '../lib/site';

const title = 'Help & FAQ — Room Planner';
const description =
  'How to use Room Planner: set room dimensions in feet, inches or metric, add doors and windows, place, rotate and lock furniture, save floor plans, share links and back up your data.';

const units = [
  { system: 'Feet & inches', example: `12'6"`, use: 'US residential' },
  { system: 'Decimal feet', example: '12.5 ft', use: 'US commercial' },
  { system: 'Inches', example: '150 in', use: 'Detailed work' },
  { system: 'Meters', example: '3.8 m', use: 'International' },
  { system: 'Centimeters', example: '380 cm', use: 'Precision metric' },
];

// One list for the app's shortcuts panel (`?`) and this page: lib/shortcuts.ts.
const shortcutGroups = SHORTCUT_GROUPS.map((g) => ({
  title: g.title,
  rows: g.shortcuts.map((s) => ({ combos: shortcutKeys(s, 'generic'), action: s.action })),
}));

const sections = [
  { id: 'getting-started', label: 'Getting started' },
  { id: 'units', label: 'Units & measurements' },
  { id: 'doors-windows', label: 'Doors & windows' },
  { id: 'furniture', label: 'Furniture' },
  { id: 'rotation', label: 'Rotating items' },
  { id: 'locking', label: 'Locking & hiding' },
  { id: 'warnings', label: 'Overlap & boundary warnings' },
  { id: 'projects', label: 'Saving & floor plans' },
  { id: 'sharing', label: 'Share links' },
  { id: 'export-import', label: 'Export & import' },
  { id: 'privacy', label: 'Your data stays in your browser' },
  { id: 'install', label: 'Install & offline' },
  { id: 'shortcuts', label: 'Keyboard shortcuts' },
];
---

<Content title={title} description={description} breadcrumbs={[{ name: 'Help', path: 'help/' }]}>
  <h1 class="text-3xl font-bold text-slate-900 mb-3">Help &amp; FAQ</h1>
  <p class="text-lg text-slate-600 mb-4">
    {SITE_NAME} is a free, drag-and-drop room layout tool. Draw your room to scale, add doors and
    windows, then arrange furniture to see what fits — on desktop or phone, with no account.
  </p>
  <p class="mb-8">
    Looking for a quick answer? See the{' '}
    <a href={withBase('faq/')} class="text-indigo-700 underline hover:text-indigo-900">
      FAQ
    </a>
    . For bed sizes, clearances and example layouts, see the{' '}
    <a href={withBase('guides/')} class="text-indigo-700 underline hover:text-indigo-900">
      room layout guides
    </a>
    .
  </p>

  <nav aria-label="Contents" class="mb-10 bg-white border border-slate-200 rounded-xl p-5">
    <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">On this page</h2>
    <ol class="grid sm:grid-cols-2 gap-x-6 gap-y-1 list-decimal list-inside text-sm">
      {sections.map((s) => (
        <li>
          <a href={`#${s.id}`} class="text-indigo-600 hover:text-indigo-800">
            {s.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <article class="space-y-10 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-slate-900 [&_h2]:mb-3 [&_h3]:font-semibold [&_h3]:text-slate-800 [&_h3]:mt-4 [&_h3]:mb-1 [&_p]:mb-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1 [&_ul]:mb-3 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:space-y-1 [&_ol]:mb-3">
    <section id="getting-started">
      <h2>Getting started: a two-step workflow</h2>
      <p>
        The planner works in two steps. Switch between them any time with the{' '}
        <strong>Design Steps</strong> buttons.
      </p>
      <h3>Step 1 — Room Setup (purple)</h3>
      <ol>
        <li>
          <strong>Set dimensions</strong> — enter the room's width and length.
        </li>
        <li>
          <strong>Pick a shape</strong> — Rectangle, L-shape (the overall size plus the corner cut
          out of it) or Custom. In Custom, drag the round corner handles on the plan (they snap to
          square and 45° walls and to the other corners), tap “+” in the middle of a wall to add a
          corner, and select a corner and press Delete to remove it. The wall list in the panel
          shows every wall's length and direction; type a length to change it. With the keyboard,
          Tab to a corner and move it with the arrow keys.
        </li>
        <li>
          <strong>Add doors</strong> — click “Add Door” and choose the wall, position, width and
          type. Doors and windows go on any wall, angled ones too.
        </li>
        <li>
          <strong>Add windows</strong> — click “Add Window” and set the wall, position and width.
        </li>
        <li>
          <strong>Fine-tune</strong> — drag the round door/window handles on the plan to slide them
          along the wall.
        </li>
      </ol>
      <p>While you set up the room, furniture is locked so you can't move it by accident.</p>
      <h3>Step 2 — Furniture (green)</h3>
      <ol>
        <li>
          <strong>Add items</strong> — click “Add Item”, then set the name, size and color. The
          arrow next to it adds an L-shaped sofa or a round table.
        </li>
        <li>
          <strong>Shape</strong> — pick Rectangle, L-shape or Round on an item's card. An L-shape
          lets you choose which corner is cut out and how big the cut is; Round fills the width and
          depth (equal sizes make a circle). Overlap and door warnings follow the real shape.
        </li>
        <li>
          <strong>Drag to move</strong> — drag any piece on the plan to reposition it.
        </li>
        <li>
          <strong>Rotate</strong> — drag the circular handle above a selected piece.
        </li>
        <li>
          <strong>Edit details</strong> — select an item in the sidebar to change its size, position
          or rotation precisely.
        </li>
        <li>
          <strong>Lock</strong> — click the lock icon so a finished piece can't be moved.
        </li>
      </ol>
      <p>While arranging furniture, doors and windows are locked.</p>
      <p>
        On a phone, the editor is a panel at the bottom of the screen with the plan above it, so you
        see each change as you make it. Drag its handle (or tap it) to make it smaller or bigger;
        tap a piece on the plan to bring up its details. Pinch to zoom and drag the background to
        pan.
      </p>
    </section>

    <section id="units">
      <h2>Units &amp; measurements</h2>
      <p>
        Choose how measurements are shown with <strong>Display Units</strong> at the top of the
        sidebar. You can switch at any time — your layout isn't changed, only how it's displayed.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden mb-3">
          <thead class="bg-slate-100 text-left">
            <tr>
              <th class="p-2">System</th>
              <th class="p-2">Example</th>
              <th class="p-2">Good for</th>
            </tr>
          </thead>
          <tbody>
            {units.map((u) => (
              <tr class="border-t border-slate-200 bg-white">
                <td class="p-2">{u.system}</td>
                <td class="p-2 font-mono">{u.example}</td>
                <td class="p-2">{u.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        <strong>Tip:</strong> you can type a value in any unit and it is converted automatically —
        for example <code>12'6"</code>, <code>12 ft 6 in</code>, <code>150in</code>,{' '}
        <code>3.5m</code>, <code>1m 20cm</code> or <code>350cm</code>. A plain number uses the
        current display unit. Press Enter or click away to apply.
      </p>
    </section>

    <section id="doors-windows">
      <h2>Doors &amp; windows</h2>
      <p>Add as many doors and windows as you need, on any wall.</p>
      <ul>
        <li>
          <strong>Wall</strong> — top, right, bottom or left.
        </li>
        <li>
          <strong>Position</strong> — distance from the start of the wall (left end for top/bottom
          walls, top end for side walls).
        </li>
        <li>
          <strong>Width</strong> — the opening size; it can't exceed the wall.
        </li>
        <li>
          <strong>Door type</strong> — <em>swing in</em> or <em>swing out</em> (one hinged door),{' '}
          <em>double (French)</em> in or out (two leaves), <em>sliding</em> (bypass or barn panels
          along the inside of the wall), <em>pocket</em> (slides into the wall),
          <em>bi-fold</em> (folds into the room) or <em>opening</em> (a doorway with no door). Swing
          doors show their swing arc so you can keep it clear of furniture; use
          <strong>Hinge</strong> to flip which side they open from (for a bi-fold, the side it folds
          to; for a pocket door, the side of its pocket).
        </li>
        <li>
          <strong>Opens to 90° or 180°</strong> — swing and double doors open to 90° by default;
          choose 180° for a door that opens flat against the wall.
        </li>
      </ul>
    </section>

    <section id="furniture">
      <h2>Furniture</h2>
      <ul>
        <li>
          <strong>Size</strong> — set an exact width and depth for each piece.
        </li>
        <li>
          <strong>Position</strong> — drag on the plan, set X/Y in the sidebar, or nudge with the
          arrow keys.
        </li>
        <li>
          <strong>Snapping &amp; guides</strong> — while you drag, a piece snaps flush against a
          wall, lines up with the edges or center of other pieces, or centers in the room, and red
          guide lines show what it lined up with. Labels show the clear distance to the nearest wall
          or piece on each side (also, more faintly, while a piece is selected). Hold
          <kbd>Alt</kbd>/<kbd>Option</kbd> while dragging to place it freely, or switch snapping off
          with the <strong>Snap</strong> button (next to the zoom controls; on phones, on the plan).
          Arrow-key moves keep their steps but snap when they end close to a wall or edge; fine
          moves (<kbd>Alt</kbd>/<kbd>Option</kbd> or <kbd>Ctrl</kbd>/<kbd>⌘</kbd> + arrow) never
          snap.
        </li>
        <li>
          <strong>Color</strong> — pick one of 10 preset colors or enter any custom hex color.
        </li>
        <li>
          <strong>Name</strong> — click the item's name in the sidebar to rename it.
        </li>
      </ul>
    </section>

    <section id="rotation">
      <h2>Rotating items</h2>
      <p>
        Select a piece and drag the circular handle above it around the piece. A badge under the
        piece shows the angle as you turn. Near straight (0°, 90°, 180°, 270°, within 8°) or a
        diagonal (45°, within 5°) it locks on: the badge turns red with a magnet and a guide line
        shows the axis. Hold <kbd>Shift</kbd> to turn in 15° steps, or <kbd>Alt</kbd> (
        <kbd>Option</kbd>
        on a Mac) to turn freely (so does switching <strong>Snap</strong> off). You can also type an
        exact angle in the sidebar's <strong>Rotation</strong> field, press <kbd>R</kbd> to turn the
        selected item 90°, or <kbd>Alt</kbd>/<kbd>Option</kbd>+<kbd>R</kbd> to turn it 1° at a time
        (add <kbd>Shift</kbd> to turn the other way).
      </p>
    </section>

    <section id="locking">
      <h2>Locking &amp; hiding</h2>
      <ul>
        <li>
          <strong>Lock</strong> an item with its lock icon to stop it being moved, resized or
          rotated. Locked items have an amber border and 🔒 badge.
        </li>
        <li>
          <strong>Hide</strong> an item with the eye icon to compare layouts with and without it.
          Hidden items disappear from the plan and are shown dashed in the sidebar.
        </li>
      </ul>
    </section>

    <section id="warnings">
      <h2>Overlap &amp; boundary warnings</h2>
      <p>
        A piece gets a red border and ⚠️ badge when it overlaps another visible piece or sticks out
        of the room. Rotation is taken into account, and pieces that only touch are fine.
      </p>
      <p>
        A softer amber, dashed border means a piece is in a door's way: <strong>Blocks door</strong>{' '}
        when it is where an inward door swings (both leaves of a double door, at the angle it opens
        to), where a bi-fold folds or where sliding panels run, and <strong>Blocks doorway</strong>{' '}
        when it stands in the passage just inside any door or opening (about 1½ ft / 45 cm deep).
        While you drag a piece into a door's way, the area that door needs lights up. Doors that
        swing outward only need their doorway clear. Hidden pieces never count.
      </p>
    </section>

    <section id="projects">
      <h2>Saving &amp; floor plans</h2>
      <ul>
        <li>
          <strong>Auto-save</strong> — every change is saved automatically in your browser; the
          header shows when it was last saved.
        </li>
        <li>
          <strong>My Floor Plans</strong> — click the folder icon to create, open, rename, duplicate
          or delete plans.
        </li>
        <li>
          <strong>Rename</strong> — click the plan's name in the header to rename it.
        </li>
        <li>
          <strong>Undo / redo</strong> — use the arrow buttons in the header or <kbd>Ctrl/⌘</kbd>+
          <kbd>Z</kbd>.
        </li>
      </ul>
    </section>

    <section id="sharing">
      <h2>Share links</h2>
      <p>
        Click <strong>Share / Save</strong> to get a link to your layout. Anyone who opens it sees
        exactly your layout, saved as a new plan in their browser. The link is a <em>snapshot</em>:
        changes you make afterwards aren't included, so share a new link after editing.
      </p>
      <p>
        The layout is stored inside the link itself (after the <code>#</code>), so it is never
        uploaded to a server.
      </p>
    </section>

    <section id="export-import">
      <h2>Export &amp; import</h2>
      <ul>
        <li>
          <strong>Image, PDF or print</strong> — click the <strong>Export</strong> button in the top
          bar to download the plan as a high-resolution PNG or a PDF (A4 or Letter, fitted to the
          page), or to print it. The plan is drawn to scale with its dimensions, a scale bar and
          every door, window and piece of furniture.
        </li>
        <li>
          <strong>Export plans</strong> — in My Floor Plans, select one or more plans and click{' '}
          <strong>Export</strong> to download a JSON backup.
        </li>
        <li>
          <strong>Import plans</strong> — paste an exported file's contents into{' '}
          <strong>Import Floor Plan(s)</strong>.
        </li>
        <li>
          <strong>Layout JSON</strong> — the Share dialog also shows the current layout as JSON you
          can copy, and accepts pasted JSON to load a layout.
        </li>
      </ul>
    </section>

    <section id="privacy">
      <h2>Your data stays in your browser</h2>
      <p>
        There's no account and no server-side storage: your floor plans live in your browser's local
        storage on this device. Clearing site data removes them, and they don't sync between devices
        — use share links or JSON export to move a plan or keep a backup.
      </p>

      <h3>Anonymous analytics</h3>
      <p>
        Your layouts are never uploaded. To improve {SITE_NAME} we collect anonymous usage analytics
        (which features are used, never your layouts or names), error reports and session replays
        (text inputs are masked) using PostHog. It is sent directly to PostHog (US cloud); content
        blockers may block it, which is fine. There are no accounts or personal profiles, and your
        browser's Do Not Track setting is respected.
      </p>
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" id="analytics-off" class="size-4 accent-indigo-600" />
        Disable analytics on this device
      </label>
    </section>

    <section id="install">
      <h2>Install &amp; offline</h2>
      <p>
        Room Planner is a progressive web app: after your first visit it works with no connection,
        and you can install it so it opens in its own window like any other app.
      </p>
      <ul>
        <li>
          <strong>Chrome, Edge and other Chromium browsers (desktop and Android):</strong> click
          <em>Install app</em> in the planner, or use the install icon in the address bar or the
          browser menu.
        </li>
        <li>
          <strong>iPhone and iPad (Safari):</strong> tap <em>Share</em>, then{' '}
          <em>Add to Home Screen</em>, then <em>Add</em>.
        </li>
        <li>
          <strong>Offline:</strong> the planner, this help page and your floor plans all work
          without internet. Share links also open offline once the app has been visited.
        </li>
        <li>
          <strong>Updates:</strong> when a new version is ready, a notice at the bottom of the
          planner offers <em>Reload</em>. Your plans save automatically, so reloading is safe.
        </li>
        <li>
          <strong>Keeping your plans safe:</strong> the app asks your browser to protect its storage
          from automatic clean-up. Installed apps are also exempt from Safari's 7-day clean-up of
          sites you haven't visited. Plans still live only on this device, so export a backup now
          and then.
        </li>
      </ul>
    </section>

    <section id="shortcuts">
      <h2>Keyboard shortcuts</h2>
      <p>
        In the planner, press <kbd>?</kbd> (or the keyboard button in the top bar) to see these with
        your keyboard's keys (⌘ ⌥ on a Mac, Ctrl Alt elsewhere). Shortcuts act while the floor plan
        (or nothing) has focus, never while you type in the sidebar or a dialog.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
          <thead class="bg-slate-100 text-left">
            <tr>
              <th class="p-2">Shortcut</th>
              <th class="p-2">Action</th>
            </tr>
          </thead>
          {shortcutGroups.map((g) => (
            <tbody>
              <tr class="border-t border-slate-200 bg-slate-50">
                <th
                  colspan="2"
                  scope="colgroup"
                  class="p-2 text-left text-xs uppercase tracking-wider text-slate-600"
                >
                  {g.title}
                </th>
              </tr>
              {g.rows.map((r) => (
                <tr class="border-t border-slate-200 bg-white">
                  <td class="p-2 leading-7">
                    {/* Each combination stays on one line; alternatives wrap on phones. */}
                    {r.combos.map((combo, ci) => (
                      <>
                        {ci > 0 && ' or '}
                        <span class="whitespace-nowrap">
                          {combo.map((k, i) => (
                            <>
                              {i > 0 && ' + '}
                              <kbd class="px-1.5 py-0.5 bg-slate-100 border border-slate-300 rounded-sm text-xs font-mono">
                                {k}
                              </kbd>
                            </>
                          ))}
                        </span>
                      </>
                    ))}
                  </td>
                  <td class="p-2">{r.action}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </section>
  </article>

  <p class="mt-12 text-center">
    <a
      href={withBase('')}
      class="inline-block px-5 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-medium transition-colors"
    >
      Start planning your room
    </a>
  </p>
</Content>

<script>
  import { isAnalyticsOptedOut, setAnalyticsEnabled } from '../lib/analytics';
  const box = document.getElementById('analytics-off') as HTMLInputElement | null;
  if (box) {
    box.checked = isAnalyticsOptedOut();
    box.addEventListener('change', () => setAnalyticsEnabled(!box.checked));
  }
</script>
