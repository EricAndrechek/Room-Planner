---
/**
 * /agents/: the MCP server for AI assistants (docs/design/plan-format.md, section 7): what it
 * does, how to add it to each client, example prompts, privacy and limits; and WebMCP in Chrome
 * (section 8).
 */
import registry from '../../server.json';
import Content from '../layouts/Content.astro';
import { withBase } from '../lib/paths';
import { PATHS } from '../../scripts/discovery.mjs';
import { PLAN_SCHEMA_PATH } from '../lib/planSchema';
import {
  API_CURL,
  COMPRESS_JS,
  COMPRESS_PYTHON,
  MCP_PATH,
  MCP_PRIVACY,
  READABLE_EXAMPLES,
  READABLE_SYNTAX,
  SITE_NAME,
} from '../lib/site';

const title = 'Room Planner for AI Assistants: Free MCP Server for Claude, ChatGPT & More';
const description =
  'Connect Claude, ChatGPT, VS Code, Cursor or Claude Code to Room Planner: your AI assistant lays out a room or a whole floor, checks it for clashes and blocked doors, and gives you a link to edit it.';

const site = Astro.site ?? new URL(Astro.url.origin);
const abs = (path: string) => new URL(withBase(path), site).toString();
const endpoint = abs(MCP_PATH);
const readable = (text: string) => `${abs('')}#p=${text}`;
/** Inline `code` in the syntax lines, as HTML (the lines are this site's own text). */
const codeHtml = (line: string) =>
  line
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>');

const vscode = JSON.stringify(
  { servers: { 'room-planner': { type: 'http', url: endpoint } } },
  null,
  2,
);
const cursor = JSON.stringify({ mcpServers: { 'room-planner': { url: endpoint } } }, null, 2);

const tools = [
  {
    name: 'create_plan',
    text: 'turns the rooms and furniture the assistant describes into a checked plan and a link that opens it in the planner. In Claude, ChatGPT and other apps that support MCP Apps, the drawing appears in the chat with any problems marked.',
  },
  {
    name: 'check_layout',
    text: 'lists overlapping pieces, pieces outside every room, furniture in a door’s swing or doorway (on either side of a door between rooms), and gaps tighter than a walkway, so the assistant can fix them before it shows you anything.',
  },
  {
    name: 'read_plan',
    text: 'reads a Room Planner link you paste into the chat, so the assistant can change your existing plan.',
  },
];

const prompts = [
  'My bedroom is 11 × 12 ft. The door is on the bottom wall near the left corner and there is a window in the middle of the top wall. Fit a queen bed, two nightstands, a dresser and a desk, and give me a Room Planner link.',
  'Lay out a 350 × 400 cm living room with a three-seat sofa facing a TV stand, a coffee table and two armchairs. Keep 90 cm walkways and nothing in front of the door.',
  'Plan a small flat: a 12 × 14 ft living room with a 10 × 11 ft bedroom to its right and a door between them. Put a sofa, a round dining table for four and a bed in, and set a spare armchair aside.',
  'Here is my plan: (paste your Room Planner link). Move the desk under the window and check that nothing blocks the door.',
];

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${abs('agents/')}#page`,
    name: 'Room Planner for AI assistants',
    description,
    url: abs('agents/'),
    inLanguage: 'en',
    isPartOf: { '@id': `${abs('')}#website` },
    about: { '@id': `${abs('')}#app` },
    mainEntity: [{ '@id': `${abs('')}#mcp` }, { '@id': `${abs('')}#api` }],
  },
  // The two ways in for agents (scripts/discovery.mjs has the same URLs for the API catalog).
  {
    '@type': 'WebAPI',
    '@id': `${abs('')}#mcp`,
    name: `${SITE_NAME} MCP server`,
    alternateName: registry.name,
    description: registry.description,
    url: endpoint,
    documentation: abs('agents/'),
    termsOfService: abs('terms/'),
    softwareVersion: registry.version,
    isAccessibleForFree: true,
    provider: { '@type': 'Organization', name: SITE_NAME, url: abs('') },
    sameAs: `${endpoint}/server-card`,
  },
  {
    '@type': 'WebAPI',
    '@id': `${abs('')}#api`,
    name: `${SITE_NAME} API`,
    description:
      'The MCP tools over plain HTTP: check a plan, make the link that opens it, read a plan from a link.',
    url: abs('api/'),
    documentation: [abs('openapi.json'), abs('agents/')],
    termsOfService: abs('terms/'),
    softwareVersion: registry.version,
    isAccessibleForFree: true,
    provider: { '@type': 'Organization', name: SITE_NAME, url: abs('') },
  },
];

const code = 'block bg-slate-900 text-slate-100 rounded-lg p-3 text-sm overflow-x-auto';
---

<Content
  title={title}
  description={description}
  breadcrumbs={[{ name: 'For AI assistants', path: 'agents/' }]}
  jsonLd={jsonLd}
>
  <h1 class="text-3xl font-bold text-slate-900 mb-3">Use {SITE_NAME} from an AI assistant</h1>
  <p class="text-lg text-slate-600 mb-8">
    {SITE_NAME} has a free MCP server. Connect it to Claude, ChatGPT or your code editor and ask the
    assistant to lay out a room: it writes the plan to scale, checks it for clashes and blocked
    doors, and gives you a link that opens the plan in the planner, where you can drag, rotate,
    measure, export and share it. No account and no API key. Without it, any assistant can still{' '}
    <a href="#plan-links" class="text-indigo-700 underline">
      give you a plan as a link
    </a>
    .
  </p>

  <article class="space-y-10 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-slate-900 [&_h2]:mb-3 [&_h3]:font-semibold [&_h3]:text-slate-800 [&_h3]:mt-5 [&_h3]:mb-1 [&_p]:mb-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1 [&_ul]:mb-3 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:space-y-1 [&_ol]:mb-3">
    <section id="url">
      <h2>The server URL</h2>
      <code class={code} tabindex="0">
        {endpoint}
      </code>
      <p class="mt-3">
        It is a remote MCP server over Streamable HTTP, with no sign-in (choose “no authentication”
        or “none” if your app asks).
      </p>
    </section>

    <section id="setup">
      <h2>Add it to your assistant</h2>

      <h3>Claude (claude.ai and the desktop app)</h3>
      <ol>
        <li>
          Open <strong>Settings → Connectors</strong> and choose{' '}
          <strong>Add custom connector</strong>.
        </li>
        <li>Name it “Room Planner”, paste the server URL above, and add it.</li>
        <li>In a chat, turn Room Planner on from the tools menu, then ask for a layout.</li>
      </ol>

      <h3>ChatGPT</h3>
      <ol>
        <li>
          Open <strong>Settings → Apps &amp; Connectors → Advanced settings</strong> and turn on{' '}
          <strong>Developer mode</strong>.
        </li>
        <li>
          Back in <strong>Apps &amp; Connectors</strong>, choose <strong>Create</strong>, paste the
          server URL, set authentication to <strong>No authentication</strong>, and create it.
        </li>
        <li>In a chat, pick Room Planner from the tools (+) menu, then ask for a layout.</li>
      </ol>

      <h3>Claude Code</h3>
      <code class={code} tabindex="0">
        claude mcp add --transport http room-planner {endpoint}
      </code>

      <h3>VS Code (GitHub Copilot agent mode)</h3>
      <p>
        Run <strong>MCP: Add Server</strong> from the Command Palette, choose HTTP and paste the
        URL, or add this to <code>.vscode/mcp.json</code>:
      </p>
      <pre class={code} tabindex="0">{vscode}</pre>

      <h3>Cursor</h3>
      <p>
        Add this to <code>~/.cursor/mcp.json</code> (or <code>.cursor/mcp.json</code> in a project):
      </p>
      <pre class={code} tabindex="0">{cursor}</pre>

      <h3>Find it in the MCP Registry</h3>
      <p>
        Room Planner is listed in the official{' '}
        <a href="https://registry.modelcontextprotocol.io" class="text-indigo-700 underline">
          MCP Registry
        </a>{' '}
        as <code>{registry.name}</code>, so apps that browse the registry can add it by name.
      </p>

      <h3>Other apps</h3>
      <p>
        Any MCP client that supports remote servers over Streamable HTTP can use the URL as it is.
      </p>
    </section>

    <section id="tools">
      <h2>What the assistant can do</h2>
      <ul>
        {tools.map((t) => (
          <li>
            <code>{t.name}</code> {t.text}
          </li>
        ))}
      </ul>
      <p>
        Lengths can be in feet, inches, meters or centimeters: the assistant uses the units you use.
        It can plan one room or a whole floor: several rooms joined by doors, L-shaped and other
        room shapes, L-shaped and round furniture, and pieces set aside for later. Every plan comes
        with a link that opens it in the planner.
      </p>
    </section>

    <section id="webmcp">
      <h2>In Chrome: let the browser's assistant edit your open plan</h2>
      <p>
        Chrome is testing WebMCP, a way for a web page to offer tools to the AI assistant built into
        the browser. Where it is turned on, {SITE_NAME} offers its own edits: the assistant can read
        the plan you have open, check it, add, move, resize, set aside or remove furniture, add
        doors and windows, and add, rename, move or remove rooms.
      </p>
      <ul>
        <li>
          Every change is one step you can undo with Ctrl+Z (⌘Z) or the Undo button, is selected on
          the plan so you see what changed, and is announced to screen readers.
        </li>
        <li>Replacing the whole plan always asks you first.</li>
        <li>
          Nothing leaves your device: the tools act on the plan in your browser, in the units you
          chose.
        </li>
      </ul>
      <p>
        To try it, use Chrome 146 or later, turn on{' '}
        <code>chrome://flags/#enable-webmcp-testing</code>, relaunch, and open {SITE_NAME}. Other
        browsers don't load any of this.
      </p>
    </section>

    <section id="plan-links">
      <h2>No setup: plan links</h2>
      <p>
        {SITE_NAME} opens a whole plan from a link: it is saved in your browser, ready to edit. The
        plan is in the part of the link after <code>#</code>, which never reaches a server. So an
        assistant without any connector can still hand you a plan. Ask it to “give me a Room Planner
        link (see {abs('llms.txt')})”. Assistants should show the link as text such as{' '}
        <a href={readable(READABLE_EXAMPLES.bedroom)} class="text-indigo-700 underline">
          Open your bedroom in Room Planner
        </a>
        , never the raw address: links get long, and browsers accept them.
      </p>
      <h3>1. Assistants with Room Planner's tools</h3>
      <p>
        With the MCP server below, or WebMCP in Chrome, the assistant uses the tools: they check the
        layout and return the link.
      </p>
      <h3>2. Agents that can make web requests</h3>
      <p>
        Agentic tools, custom agents and ChatGPT Custom GPTs can call the same operations over plain
        HTTP, with no key: <code>POST /api/plan/check</code>, <code>POST /api/plan/link</code> (the
        plan, its problems and the link) and <code>GET /api/plan?url=…</code> (read a link). The
        description, in OpenAPI 3.1, is{' '}
        <a href={abs('openapi.json')} class="text-indigo-700 underline">
          /openapi.json
        </a>
        . Code sandboxes in ChatGPT and Claude.ai usually have no internet; they use the next way.
      </p>
      <pre class={code} tabindex="0">{API_CURL}</pre>
      <p class="mt-3">
        <strong>As a ChatGPT Custom GPT Action:</strong> in the GPT editor, choose{' '}
        <strong>Configure → Create new action → Import from URL</strong>, paste{' '}
        <code>{abs('openapi.json')}</code>, set authentication to <strong>None</strong> and the
        privacy policy to <code>{abs('privacy/')}</code>. Then tell the GPT: “Use createPlanLink and
        give me the link as text.”
      </p>
      <h3>3. Assistants that can run code</h3>
      <p>
        ChatGPT's data analysis, Claude's analysis tool or Gemini's code execution can build the
        plan as JSON (the format is{' '}
        <a href={abs(PLAN_SCHEMA_PATH)} class="text-indigo-700 underline">
          /{PLAN_SCHEMA_PATH}
        </a>
        , the same as the MCP tools take), compress it and make a <code>#s=</code> link. This works
        for a plan of any size and shape.
      </p>
      <pre class={code} tabindex="0">{COMPRESS_PYTHON}</pre>
      <pre class={`${code} mt-3`} tabindex="0">{COMPRESS_JS}</pre>
      <h3>4. Assistants with none of these: the readable form</h3>
      <p>
        For a small plan (a room or two, rectangles, round and L-shaped pieces), an assistant can
        write the plan itself after <code>#p=</code>. For a bigger or odd-shaped floor, the code way
        is better.
      </p>
      <ul>
        {READABLE_SYNTAX.map((l) => (
          <li set:html={codeHtml(l)} />
        ))}
      </ul>
      <p>Examples:</p>
      <ul>
        <li>
          <a href={readable(READABLE_EXAMPLES.bedroom)} class="text-indigo-700 underline">
            A 12 × 11 ft bedroom
          </a>
          : <code class="break-all">#p={READABLE_EXAMPLES.bedroom}</code>
        </li>
        <li>
          <a href={readable(READABLE_EXAMPLES.flat)} class="text-indigo-700 underline">
            A flat with a living room and a bedroom
          </a>
          : <code class="break-all">#p={READABLE_EXAMPLES.flat}</code>
        </li>
      </ul>
    </section>

    <section id="examples">
      <h2>Things to ask</h2>
      <ul>
        {prompts.map((p) => (
          <li>“{p}”</li>
        ))}
      </ul>
    </section>

    <section id="privacy">
      <h2>Privacy</h2>
      <p>{MCP_PRIVACY}</p>
      <p>
        The planner itself never uploads your floor plans: they stay in your browser. A plan reaches
        the MCP server only when you ask an AI assistant to use it, and only the plan the assistant
        sends. Your assistant's own privacy terms cover the chat itself.
      </p>
    </section>

    <section id="limits">
      <h2>Limits</h2>
      <ul>
        <li>Free, with no account. Each address can make about 120 requests a minute.</li>
        <li>Up to 50 rooms and 500 pieces of furniture per plan, and 256 KB per request.</li>
        <li>
          The server makes no images; apps that support MCP Apps draw the plan in the chat, and the
          link always shows it in the planner.
        </li>
      </ul>
      <p>
        For developers: the server is stateless and speaks both current MCP protocol versions. Its
        server card is at{' '}
        <a href={abs(`${MCP_PATH}/server-card`)} class="text-indigo-700 underline">
          /{MCP_PATH}/server-card
        </a>
        , and the source is on{' '}
        <a href="https://github.com/EricAndrechek/Room-Planner" class="text-indigo-700 underline">
          GitHub
        </a>
        .
      </p>
      <p>
        No authentication: the MCP server and REST API are open; there is intentionally no OAuth
        metadata.
      </p>
      <p>
        Agents can also find all of this on their own: the{' '}
        <a href={abs(PATHS.aiCatalog.slice(1))} class="text-indigo-700 underline">
          AI catalog
        </a>{' '}
        lists the MCP server, the REST API and a{' '}
        <a href={abs(PATHS.skill.slice(1))} class="text-indigo-700 underline">
          Room Planner skill
        </a>{' '}
        (also in the{' '}
        <a href={abs(PATHS.agentSkills.slice(1))} class="text-indigo-700 underline">
          Agent Skills index
        </a>
        ), and <code>{abs(PATHS.search.slice(1))}?q=…</code> searches this site's pages, answering
        in Markdown.
      </p>
    </section>
  </article>

  <p class="mt-10">
    New to the planner? The{' '}
    <a href={withBase('help/')} class="text-indigo-700 underline">
      help page
    </a>{' '}
    explains every feature, and the{' '}
    <a href={withBase('guides/')} class="text-indigo-700 underline">
      room layout guides
    </a>{' '}
    list furniture sizes and clearances.
  </p>
</Content>
