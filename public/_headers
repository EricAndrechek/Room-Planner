# Cloudflare Workers static-assets headers. Rules are additive: when several rules
# match a path, their headers are merged (same header names are comma-joined), so
# Cache-Control is set ONLY on specific paths, never on /*.
# Default for assets without a rule is `public, max-age=0, must-revalidate`.
#
# CSP rationale (edit the one line under /* to adjust; verify in a browser after changes):
#  - default-src 'self'             everything is same-origin by default.
#  - script-src 'self' 'unsafe-inline' (in this source file) -> 'sha256-...' hashes (in dist)
#        Built HTML has inline scripts (Astro island bootstrap, the PostHog snippet with
#        define:vars). Their hashes change per build, so scripts/csp-hashes.mjs (run by `build`
#        and `build:ci` after `astro build`) hashes every inline <script> in dist/**/*.html
#        (JSON-LD excluded: not executable) and replaces 'unsafe-inline' in dist/_headers.
#        The build fails if this line or that token is missing, so keep both here.
#        No 'unsafe-eval'. PostHog's snippet loads array.js and lazy bundles (recorder,
#        exceptions, web vitals) from *.posthog.com (us-assets.i.posthog.com), so the wildcard
#        host is allowed too.
#  - style-src 'self' 'unsafe-inline'   Astro scoped styles and React inline style="" attributes.
#  - img-src 'self' data: blob:         canvas exports, data-URI icons, blob previews.
#  - font-src 'self' data:
#  - connect-src 'self' https://*.posthog.com   events/replay go to us.i.posthog.com. PostHog serves
#        from subdomains that change over time, so its docs recommend the wildcard
#        (https://posthog.com/docs/advanced/content-security-policy). Toolbar/surveys are not used,
#        so no extra img-src/style-src/frame-src entries.
#  - Cloudflare Web Analytics: the andrechek.com zone auto-injects its RUM beacon
#        (static.cloudflareinsights.com script, reports to cloudflareinsights.com), so both are
#        allowed in script-src / connect-src. Drop them if that zone setting is turned off.
#  - worker-src 'self' blob: data:      service worker (/sw.js) and PostHog replay web worker.
#  - manifest-src 'self'
#  - object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'.
#  - frame-src is not set, so it falls back to default-src 'self'.
#  - upgrade-insecure-requests
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.posthog.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.posthog.com https://cloudflareinsights.com; worker-src 'self' blob: data:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Hashed build output: cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker and manifest: must always revalidate so updates roll out.
# (workbox-<hash>.js is content-hashed but is imported by sw.js; keep it revalidating
# too, it is tiny and avoids stale-precache surprises. The SW is registered by the app
# bundle, so there is no registerSW.js.)
/sw.js
  Cache-Control: no-cache
/workbox-*
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
