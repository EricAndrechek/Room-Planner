# PostHog analytics + error tracking. All optional: with no key, analytics is disabled.
# The project token is public (it ships in the JS bundle), but is still set via env.
PUBLIC_POSTHOG_KEY=phc_your_project_token
# Defaults to the same-origin /ingest reverse proxy (see worker/index.ts).
PUBLIC_POSTHOG_HOST=/ingest
# production (default) | preview
PUBLIC_DEPLOY_ENV=production
