{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 4
    },
    "name": {
      "default": "Untitled",
      "type": "string",
      "maxLength": 100
    },
    "unit": {
      "type": "string",
      "enum": ["ft", "in", "m", "cm"],
      "description": "Unit of every length in this document."
    },
    "rooms": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$",
            "description": "Unique within the plan. Letters, digits, \"-\" and \"_\"."
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "outline": {
            "minItems": 3,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "y": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                }
              },
              "required": ["x", "y"]
            },
            "description": "Interior corners in floor coordinates, clockwise as drawn (y grows downward). A rectangle is 4 points starting at its top-left corner; its walls are then 0 = top, 1 = right, 2 = bottom, 3 = left."
          },
          "openings": {
            "default": [],
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,40}$",
                  "description": "Unique within the plan. Letters, digits, \"-\" and \"_\"."
                },
                "kind": {
                  "type": "string",
                  "enum": ["door", "window"]
                },
                "wall": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Wall index. Wall i runs from outline[i] to outline[i+1]."
                },
                "offset": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Distance along the wall from its start corner to the near edge of the opening."
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000,
                  "description": "Width along the wall."
                },
                "from": {
                  "description": "Input only: which end of the wall offset is measured from. \"start\" (default) is the start corner (on a rectangle: top wall from the left, right wall from the top, bottom wall from the right, left wall from the bottom); \"end\" is the other end. Or name the end as seen from above: \"left\" or \"right\" on a top or bottom wall, \"top\" or \"bottom\" on a left or right wall. The plan comes back with offset measured from the start corner.",
                  "type": "string",
                  "enum": ["start", "end", "left", "right", "top", "bottom"]
                },
                "type": {
                  "default": "swing-in",
                  "description": "Doors only.",
                  "type": "string",
                  "enum": [
                    "swing-in",
                    "swing-out",
                    "double-in",
                    "double-out",
                    "sliding",
                    "pocket",
                    "bifold",
                    "opening"
                  ]
                },
                "hinge": {
                  "default": "start",
                  "description": "Doors only. Seen from inside the room facing the wall, \"start\" is on the left.",
                  "type": "string",
                  "enum": ["start", "end"]
                },
                "swingAngle": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 90
                    },
                    {
                      "type": "number",
                      "const": 180
                    }
                  ]
                }
              },
              "required": ["id", "kind", "wall", "offset", "width"],
              "additionalProperties": {}
            }
          }
        },
        "required": ["id", "outline"],
        "additionalProperties": {}
      }
    },
    "items": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$",
            "description": "Unique within the plan. Letters, digits, \"-\" and \"_\"."
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "color": {
            "default": "#93c5fd",
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "shape": {
            "default": "rect",
            "type": "string",
            "enum": ["rect", "l", "ellipse"]
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000,
            "description": "Bounding-box size along x before rotation."
          },
          "depth": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000,
            "description": "Bounding-box size along y before rotation."
          },
          "cut": {
            "description": "Shape \"l\" only: the rectangle removed from one corner of the bounding box.",
            "type": "object",
            "properties": {
              "corner": {
                "type": "string",
                "enum": ["tl", "tr", "br", "bl"]
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              "depth": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              }
            },
            "required": ["corner", "width", "depth"]
          },
          "placement": {
            "description": "Centre of the piece in floor coordinates and its clockwise rotation in degrees. Omit it to set the piece aside: kept in the plan, not on the floor.",
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              "y": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              "rotation": {
                "default": 0,
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              }
            },
            "required": ["x", "y"]
          },
          "locked": {
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": ["id", "label", "width", "depth"],
        "additionalProperties": {}
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "unitSystem": {
          "type": "string",
          "enum": ["ft-in", "ft", "in", "m", "cm"]
        }
      },
      "additionalProperties": {}
    }
  },
  "required": ["version", "unit", "rooms"],
  "additionalProperties": {}
}
