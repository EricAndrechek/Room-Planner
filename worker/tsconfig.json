{
  // The Worker and, by inclusion, the core it imports: Workers types and no DOM, which proves
  // src/core compiles without the browser (docs/design/plan-format.md, section 6).
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    // @wave-rf/cloudflare-md-router ships TypeScript source with `.ts` imports.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["./viewer/**"]
}
